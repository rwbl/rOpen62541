Build1=Default,B4RDev
Group=Default Group
Library1=rconvert
Library2=rcore
Library3=resp8266wifi
Library4=ropen62541
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=4
@EndOfDesignText@
#Region Project Header
'==============================================
' Project:		rOpen6241
' Brief:		Example in- and output with an LED and Pushbutton.
' Date:			See process_globals VERSION
' Author: 		Robert W.B. Linn (c) 2026 MIT - see LICENSE file.
' Description:	This example uses an LED as output and pushbutton as input.
'				The state of the LED is set by writing a boolean (true or false) to the node ns=1;s=System.LedState
'				Scenario 1
'				- The pushbutton sets the state of the LED on or off.
'				- If the LED state changes, the nodeid ns=1;System.LedState is updated with false or true.
'				Scenario 2
'				- The server receives a msg from the connected client with nodeid ns=1;System.LedState.
'				- The event OnDataWrite with the nodeid and 4-byte array as value is triggered.
'				- Nodeid ns=1;System.LedState i selected and the first byte of the value is used used to set the state of the LED to true or false.
' Hardware:		diymore ESP32-S3 DevKitC-1 N16R8
'				Board settings:
'				- Unleash the 8MB Octal PSRAM footprint
'				- Partitionscheme: Huge App
'				- PSRAM: OPI PSRAM
' Software:		B4R 4.00 (64 bit), IDE ESP32 Dev Module
'				Arduino Board Manager ESP32 3.3.12.
'				rOpen62541, rConvert
' Wiring:		(Output) ESP32S3 = LED: IO12 = Signal; GND = GND; Input
'				(Input) ESP32S3 = Pushbutton (DFRobot): IO14 = Signal; 3.3V = VCC; GND = GND
' Log:
'==============================================
#End Region

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 900
#End Region
'Ctrl+Click to open the C code folder: ide://run?File=%WINDIR%\System32\explorer.exe&Args=%PROJECT%\Objects\Src

Sub Process_Globals
	Private VERSION 			As String = "rOpen62541 InOutput v20261012"

	' Communication
	Public Serial1 				As Serial
	Private WiFi 				As ESP8266WiFi						' Lib rESP8266WiFi
	Private SSID				As String = "***"
	Private PW 					As String = "***"

	' LED
	Private LedRedPin As Pin
	Private LED_PIN_NR 			As Byte = 12
	Private LedState 			As Boolean			' Keep the ledstate set by the button or opc
	
	' Buttons
	Private ButtonPin 			As Pin
	Private BUTTON_PIN_NR 		As Byte = 14
	
	' Open62541
	Private OPCUAServer			As Open62541		' Lib rOpen62541
	Private PORT 				As Int = 4840
	Private NODEID_LED_STATE 	As String = "ns=1;s=System.LedState"

	'Helper
	Private FirstTime As Boolean = True
End Sub

Sub AppStart
	Serial1.Initialize(115200)
	Log(CRLF, "[AppStart] ", VERSION)
	
	' Init Input and Output
	LedRedPin.Initialize(LED_PIN_NR, LedRedPin.MODE_OUTPUT)
	LedState = False
	LedRedPin.DigitalWrite(LedState)

	ButtonPin.Initialize(BUTTON_PIN_NR, ButtonPin.MODE_INPUT_PULLUP)
	ButtonPin.AddListener("Button_StateChanged")
	
	' Connect to the network first
	If WiFi.Connect2(SSID, PW) Then
		Log("[AppStart] WiFi connected > local ip=", WiFi.LocalIP)
		' [AppStart] WiFi connected. IP=192.168.1.176

		RunNative("DisableWiFiSleep", Null)
		RunNative("SetSystemClock", Null)
	       
		Log("[AppStart] OPC UA server init...")
		If InitOPCUAServer Then
			Log("[AppStart] OPC UA server started")
		End If
	Else
		Log("[AppStart][E] WiFi Connection Failed")
	End If
End Sub

#Region OPCUAServer
' InitOPCUAServer
' Steps:
' Init the server with ip, port and client callback
' Wait till the opc ua server has been started successfully
' Add various nodes
Private Sub InitOPCUAServer As Boolean
	Dim TimeoutCounter As Int = 0
	Dim ServerBootFailed As Boolean = False

	Log("[InitOPCUAServer] Initializing...")
	' Spin up the Core 0 open62541 network engine with callback
	OPCUAServer.Initialize(WiFi.LocalIp, PORT, _
						   "", "", _
						   Null, _					' Event to handle special trigger by client not used
						   "OnDataWrite")			' Event triggered when clients writes to a node
	
	' Wait for the background thread layout initialization to complete!
	Log("[InitOPCUAServer] Awaiting background core network initialization...")
	Do While OPCUAServer.IsReady = False
		' 100ms yield ticks for the cooperative scheduler
		Delay(100) 
        
		TimeoutCounter = TimeoutCounter + 1
		' 50 ticks * 100ms = 5000ms (5 Seconds Timeout)
		If TimeoutCounter >= 50 Then 
			ServerBootFailed = True
			' Break out of the endless loop safely!
			Exit 
		End If
	Loop
    
	If ServerBootFailed Then
		Log("[InitOPCUAServer][E] Initialization failed by TIMEOUT.")
		' Optional: Run local emergency fallback routine or let local sensors run offline
	Else
		Log("[InitOPCUAServer] OK")
		' Register nodes
		OPCUAServer.AddBooleanNode(NODEID_LED_STATE, "LED State", False)
	End If
	Return Not(ServerBootFailed)
End Sub

'==============================================
' EVENTS
'==============================================

' OnDataWrite
' This event is fired when client changed a node value.
' Parameter:
'	nodeid - Node id which value is updated, e.g, ns=1;s=System.LedState
'	rawvalue - 4-Byte Array. The first byte holds the LED state 1 (ON) or 0 (OFF)
' Example:
' [OnDataWrite] OPC UA Client write to nodeid=ns=1;s=System.LedState, value=01000000 length=4
Private Sub OnDataWrite(nodeid As String, rawvalue() As Byte)
	Log("[OnDataWrite] OPC UA Client write to nodeid=", nodeid, ", value=", Convert.BytesToHex(rawvalue), " length=", rawvalue.Length)

	Select nodeid
		Case NODEID_LED_STATE
			Dim state As Boolean = Convert.ByteToBool(rawvalue(0))
			Log("[OnDataWrite] state=", state)
			LedRedPin.DigitalWrite(state)
		' add more
	End Select
End Sub
#End Region

#Region Button
'Handle button state changed. 
'This is a pushbutton, means when pressing the button the LED will be turned on, when releasing again the LED is turned OFF.
Sub Button_StateChanged (State As Boolean)
	' Disable firsttime else led is turned on 
	If FirstTime Then
		FirstTime = Not(FirstTime)
		Return
	End If
	Log("[Button_StateChanged] Button state: ", State)
	
	'The state will be false when the button is clicked because of the PULLUP mode.
	If Not(State) Then
		' Set Led state
		LedState = Not(LedState)
		LedRedPin.DigitalWrite(LedState)
		
		' Update the opc ua node
		OPCUAServer.WriteBoolean(NODEID_LED_STATE, LedState)
	End If
End Sub
#End Region

'==============================================
' INLINEC
'==============================================

#if C
#include "esp_wifi.h"

void DisableWiFiSleep(B4R::Object* o) {
    // Force Espressif lwIP stack to set Power Save to NONE
    esp_wifi_set_ps(WIFI_PS_NONE);
    ::Serial.println("[Hardware Engine] Wi-Fi Modem-Sleep forcefully disabled! Radio set to high-performance mode.");
}

// RunNative("SetSystemClock", Null)
void SetSystemClock(B4R::Object* o) {
    // Configures the system to poll pool.ntp.org with a standard global UTC offset
    // Adjust the 3600 (seconds) based on your target local timezone offset (e.g. 3600 = UTC+1)
    configTime(3600, 0, "pool.ntp.org", "time.nist.gov");
    ::Serial.println("[SetSystemClock] SNTP Client started. Synchronizing baseline...");
}
#End If
