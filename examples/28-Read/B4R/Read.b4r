#Region Project Header
'==============================================
' Project:		rOpen6241
' Brief:		Read the value or attribute of a node.
' Date:			See process_globals VERSION.
' Author: 		Robert W.B. Linn
' License:		MIT — see LICENSE file.
' Description:	Demonstrates querying node data.
' Hardware:		ESP32-S3-N16R8
'				Board settings:
'				ESP32 Dev Module (COM15)
'				Unleash the 8MB Octal PSRAM footprint
'				Partitionscheme: Huge App
'				PSRAM: OPI PSRAM
' Software:		B4R 4.00 (64 bit), IDE ESP32 Dev Module
'				Arduino Board Manager ESP32 3.3.12.
' Wiring:		N/A
' B4R Log:
'				[AppStart] OPC UA server started
'				[Tests] Start
'				[GetServerTime] ns=0;i=2258=1970-01-01 00:00:02Z
'				[ReadDataValue] nodeid=ns=1;s=Tag1
'				=========== LOCAL DATABASE CACHE SNAPSHOT ===========
'				Node Identifier: Tag1
'				Status Code:     0x0
'				Current Value:   1958.0000
'				hasSourceTime:   1
'				SourceTime Hex:  0x01DD5E348B38453A
'				hasServerTime:   1
'				ServerTime Hex:  0x01DD5E348B384486
'				=====================================================
'				[ReadDataAtrribute] nodeid=ns=1;s=Tag1, attr=0
'				[ReadDataAtrribute] RawValue=1958
'				[ReadDataAtrribute] nodeid=ns=1;s=Tag1, attr=1
'				[ConvertOpcTimestampToUnix] data=04B9768C345EDD01, length=8, seconds=1792240767
'				[ReadDataAtrribute] Source timestamp=1792240767
'				[ReadDataAtrribute] nodeid=ns=1;s=Tag1, attr=2
'				[ConvertOpcTimestampToUnix] data=20F4148D345EDD01, length=8, seconds=1792240768
'				[ReadDataAtrribute] Server timestamp=1792240768
'				[ReadDataAtrribute] nodeid=ns=1;s=Tag1, attr=3
'				[ReadDataAtrribute] Status=00000000
'				[Tests] Done
'				[GetServerTime] ns=0;i=2258=2026-10-17 12:39:30Z
'==============================================
#End Region

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 600
#End Region
'Ctrl+Click to open the C code folder: ide://run?File=%WINDIR%\System32\explorer.exe&Args=%PROJECT%\Objects\Src

Sub Process_Globals
	Private VERSION 			As String = "rOpen62541 Read v20261017"

	' Communication
	Public Serial1 				As Serial
	Private WiFi 				As ESP8266WiFi						' Lib rESP8266WiFi
	Private SSID				As String = "***"
	Private PW 					As String = "***"
	
	' Open62541
	Private OPCUAServer			As Open62541						' Lib rOpen62541
	Private PORT 				As Int = 4840

	' Nodes
	Private NODEID_SERVERTIME 	As String = "ns=0;i=2258"
	Private NODEID_TAG1			As String = "ns=1;s=Tag1"
	
	'Helper
	Private bc As ByteConverter	'ignore
End Sub

Sub AppStart
	Serial1.Initialize(115200)
	Log(CRLF, "[AppStart] ", VERSION)
	
	' Connect to the network first
	If WiFi.Connect2(SSID, PW) Then
		Log("[AppStart] WiFi connected > local ip=", WiFi.LocalIP)
		' [AppStart] WiFi connected. IP=192.168.1.68

		Log("[AppStart] Disable deep sleep...")
		RunNative("DisableWiFiSleep", Null)

		Log("[AppStart] Synchronizing system clock via NTP...")
		RunNative("SetSystemClock", Null)

		Log("[AppStart] Init opc server")
		If InitOpcUaServer Then
			Log("[AppStart] OPC UA server started")
			CallSubPlus("GetServerTime", 5000, 0)
		End If
	Else
		Log("[AppStart][E] WiFi Connection Failed")
	End If
End Sub

' InitOpcServer
' Steps:
' Init the server with ip, port and client callback
' Wait till the opc server has been started successfully
' Add various nodes
Private Sub InitOpcUaServer As Boolean
	Dim TimeoutCounter As Int = 0
	Dim ServerBootFailed As Boolean = False

	Log("[InitOpcUaServer] Initializing...")
	OPCUAServer.Initialize(WiFi.LocalIp, PORT, _
							"", "", _				' No auth
							Null, Null)				' No callbacks
	
	' Wait for the background thread layout initialization to complete!
	Log("[InitOpcUaServer] Awaiting background core network initialization...")
	Do While OPCUAServer.IsReady = False
		' 100ms yield ticks for the cooperative scheduler
		Delay(100) 
        
		TimeoutCounter = TimeoutCounter + 1
		' 50 ticks * 100ms = 5000ms (5 Seconds Timeout)
		If TimeoutCounter >= 50 Then 
			ServerBootFailed = True
			' Break out of the endless loop safely!
			Exit 
		End If
	Loop
    
	If ServerBootFailed Then
		Log("[InitOpcUaServer][E] Failed caused by TIMEOUT.")
		' Optional: Run local emergency fallback routine or let local sensors run offline
	Else
		OPCUAServer.AddFloatNode(NODEID_TAG1, "Tag1", 1958.0)
		CallSubPlus("Tests", 1000, 5)
		Log("[InitOpcUaServer] OK")
	End If
	Return Not(ServerBootFailed)
End Sub

Private Sub Tests(tag As Byte)
	Log("[Tests] Start")
	GetServerTime(0)
	Delay(1000)
	ReadDataValue(NODEID_TAG1)
	Delay(1000)
	For i = 0 To 3
		ReadDataAtrribute(NODEID_TAG1, i)
		Delay(1000)		
	Next
	Log("[Tests] Done")
End Sub
Private Sub GetServerTime(tag As Byte)
	Dim nodeid As String = NODEID_SERVERTIME
	Log("[GetServerTime] ", nodeid, "=", OPCUAServer.ReadNumeric(nodeid))
	' [GetServerTime] ns=0;i=2258=2026-10-12 09:18:38Z
End Sub

Private Sub ReadDataValue(nodeid As String)
	Log("[ReadDataValue] nodeid=", nodeid)
	OPCUAServer.ReadDataValue(nodeid)
End Sub

Private Sub ReadDataAtrribute(nodeid As String, attr As Int)
	Log("[ReadDataAtrribute] nodeid=", nodeid, ", attr=", attr)
	Dim b() As Byte = OPCUAServer.ReadDataAttribute(nodeid, attr)
	Select attr
		Case 0
			' RawValue
			Log("[ReadDataAtrribute] RawValue=", Convert.BytesToFloat(b))
		Case 1
			' Source Timestamp
			Log("[ReadDataAtrribute] Source timestamp=", ConvertOpcTimestampToUnix(b))
		Case 2
			' Server Timestamp
			Log("[ReadDataAtrribute] Server timestamp=", ConvertOpcTimestampToUnix(b))
		Case 3
			' Status
			Log("[ReadDataAtrribute] Status=", Convert.BytesToHex(b))
	End Select
	
End Sub

' HELPERS
' Decodes an 8-byte raw OPC UA Source/Server timestamp into standard Unix time seconds
Private Sub ConvertOpcTimestampToUnix(rawBytes() As Byte) As Long
	' Log("[ConvertOpcTimestampToUnix] data=", bc.HexFromBytes(rawBytes), ", length=", rawBytes.length)

	If rawBytes.Length <> 8 Then
		Log("[ConvertOpcTimestampToUnix][E] Invalid timestamp byte array length!")
		Return 0
	End If

	' Execute the Inline C function directly on the hardware stack core
	Dim currentUnixTime As Long = RunNative("ConvertOpcBytesToUnix", rawBytes)
	Log("[ConvertOpcTimestampToUnix] data=", bc.HexFromBytes(rawBytes), ", length=", rawBytes.length, ", seconds=", currentUnixTime)

	Return currentUnixTime
End Sub

'==============================================
'INLINE C HELPERS
'==============================================

#if C
#include "esp_wifi.h"
#include "time.h"

// Disable wi-fi sleep layers
// Forces the ESP32-S3 Wi-Fi radio to stay 100% active, dropping latency
// from ~100ms+ down to an immediate 2ms, completely wiping out Bad_Timeout.
// RunNative("DisableWiFiSleep", Null)
void DisableWiFiSleep(B4R::Object* o) {
    // Force Espressif lwIP stack to set Power Save to NONE
    esp_wifi_set_ps(WIFI_PS_NONE);
    ::Serial.println("[Hardware Engine] Wi-Fi Modem-Sleep forcefully disabled! Radio set to high-performance mode.");
}

// Synchronize system clock via NTP.
// RunNative("SetSystemClock", Null)
void SetSystemClock(B4R::Object* o) {
    // Configures the system to poll pool.ntp.org with a standard global UTC offset
    // Adjust the 3600 (seconds) based on your target local timezone offset (e.g. 3600 = UTC+1)
    configTime(3600, 0, "pool.ntp.org", "time.nist.gov");
    ::Serial.println("[Hardware Engine] SNTP Client started. Synchronizing baseline...");
}

// Decodes 8 raw Little Endian bytes from open62541 directly into a standard Unix timestamp
// Accepts exactly the native B4R arguments pointer context
B4R::Object* ConvertOpcBytesToUnix(B4R::Object* args) {
// 1. Convert the incoming argument to your ArrayByte using your rCore.h signature
    B4R::ArrayByte* OpcBytes = (B4R::ArrayByte*)B4R::Object::toPointer(args);

    // Safety Check: Verify we have exactly 8 bytes of tracking data
    if (OpcBytes == NULL || OpcBytes->length != 8) {
        return args; 
    }

    // 2. Cast raw array bytes straight into a native 64-bit unsigned integer
    uint64_t rawTicks = *(uint64_t*)OpcBytes->data;

    // 3. Convert 100-nanosecond blocks to seconds, then subtract the Windows-to-Unix epoch shift constant
    Long unixSeconds = (Long)((rawTicks / 10000000ULL) - 11644473600ULL);
   
	B4R::Object* tmp = new B4R::Object();
	tmp->data.ULongField = unixSeconds;
    return tmp;
}	
#End If
