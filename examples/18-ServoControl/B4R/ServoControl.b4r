@EndOfDesignText@
#Region Project Header
'==============================================
' Project:		rOpen6241
' Brief:		Example to control servo position open or close.
' Date:			2026-10-02
' Author: 		Robert W.B. Linn
' License:		MIT — see LICENSE file.
' Description:	This example has an servo motor connected to the ESP32S3.
'				The servo acts as a gate with position open or close.
'				An Traffic-Light-LED (output) shows the state open (green) or close (red).
'				A push-button (input) can also be used to open or close the gate.
'				The OPC UA client sends the trigger message "ns=1;s=Trigger" with string values `gateopen` or `gateclose`.
' Hardware:		ESP32-S3-N16R8
'				Board settings:
'				- ESP32S3 Dev Module
'				- Unleash the 8MB Octal PSRAM footprint
'				- Partitionscheme: Huge App
'				- PSRAM: OPI PSRAM
' Software:		B4R 4.00 (64 bit), IDE ESP32S3 Dev Module
'				Arduino Board Manager ESP32 3.3.12.
' Libraries:	rESP32Servo 1.10, rESP8266WiFi 1.6, rOpen62541 0.70, rRandomAccessFile1.91
' Wiring:		Output
'				ESP32S3 = REDLED; IO42 = Signal; GND = GND
'				ESP32S3 = GREENLED; IO40 = Signal; GND = GND
'				Input
'				ESP32S3 = Servo; IO14 = Signal; 5V = VCC; GND = GND
'				ESP32S3 = Pushbutton (DFRobot); IO4 = Signal; 3.3V = VCC; GND = GND
' Log:
'==============================================
#End Region

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 900
#End Region
'Ctrl+Click to open the C code folder: ide://run?File=%WINDIR%\System32\explorer.exe&Args=%PROJECT%\Objects\Src

Sub Process_Globals
	Private VERSION 			As String = "rOpen62541 ServoControl v20261002"

	' Communication
	Public Serial1 				As Serial
	Private WiFi 				As ESP8266WiFi						' Lib rESP8266WiFi
	Private SSID				As String = "***"
	Private PW 					As String = "***"
	
	' Open62541
	Private OPCUAServer			As Open62541						' Lib rOpen62541
	Private PORT 				As Int = 4840
	' Nodes (lowercase) using for tests different name spaces
	Private NODEID_TRIGGER		As String = "ns=1;s=trigger"		'
	Private NODEID_STATE 		As String = "ns=1;s=gatestate"		'

	Private NAMESPACEINDEX		As Byte = 1
	Private NODEID_STATE_STRING	As String = "gatestate"		'

	' Commands
	Private CMD_GATE_OPEN 		As String = "gateopen"
	Private CMD_GATE_CLOSE 		As String = "gateclose"
	' States
	Private STATE_GATE_OPEN 	As Byte = 1
	Private STATE_GATE_CLOSED 	As Byte = 0
	
	' Servo
	Private Servo As ESP32Servo
	Private ServoPin As Pin
	Private SERVO_PIN_NR As Byte = 14	
	Private SERVO_MIN_ANGLE As UInt = 90
	Private SERVO_MAX_ANGLE As UInt = 135
	
	' LEDs
	Private LedRedPin As Pin
	Private LED_RED_PIN_NR As Byte = 42
	Private LedRedState As Boolean				' Keep the ledred state set by the button or opcua server
	Private LedGreenPin As Pin
	Private LED_GREEN_PIN_NR As Byte = 40
	Private LedGreenState As Boolean			' Keep the green state set by the button or opcua server
	
	' Button
	Private ButtonPin As Pin
	Private BUTTON_PIN_NR As Byte = 4
	
	'Helper
	Private FirstTime As Boolean = True
	Private ByteConv As ByteConverter	'ignore
End Sub

Sub AppStart
	Serial1.Initialize(115200)
	Log(CRLF, "[AppStart] ", VERSION)
	
	' Init Components
	LedRedPin.Initialize(LED_RED_PIN_NR, LedRedPin.MODE_OUTPUT)
	LedRedState = False
	LedRedPin.DigitalWrite(LedRedState)
	LedGreenPin.Initialize(LED_GREEN_PIN_NR, LedGreenPin.MODE_OUTPUT)
	LedGreenState = False
	LedGreenPin.DigitalWrite(LedGreenState)
	
	ButtonPin.Initialize(BUTTON_PIN_NR, ButtonPin.MODE_INPUT_PULLUP)
	ButtonPin.AddListener("Button_StateChanged")
	
	ServoPin.Initialize(SERVO_PIN_NR, ServoPin.MODE_OUTPUT)
	
	SetServoOpen
	
	' Connect to the network first
	If WiFi.Connect2(SSID, PW) Then
		Log("[AppStart] WiFi connected > local ip=", WiFi.LocalIP)
		' [AppStart] WiFi connected. IP=192.168.1.68

		RunNative("DisableWiFiSleep", Null)
	       
		Log("[AppStart] Init OPC UA server")
		If InitOPCUAServer Then
			Log("[AppStart] OPC UA server started")
		End If
	Else
		Log("[AppStart][E] WiFi Connection Failed")
	End If
End Sub

#Region OPCUASERVER
' InitOPCUAServer
' Steps:
' Init the server with ip, port and client callback
' Wait till the opc server has been started successfully
' Add various nodes
Private Sub InitOPCUAServer As Boolean
	Dim TimeoutCounter As Int = 0
	Dim ServerBootFailed As Boolean = False

	Log("[InitOPCUAServer] Start...")

	' Init OPC UA server with data write event (received from the connected client with nodeid ns=1;s=trigger)
	' Ensure to set: OPCUAServer.AddStringNode("Trigger", "Remote Action Trigger", "0")
	OPCUAServer.Initialize(WiFi.LocalIp, PORT, "", "", "OnDataWrite")
	
	' Wait for the background thread layout initialization to complete!
	Log("[InitOPCUAServer] Awaiting background core network initialization...")
	Do While OPCUAServer.IsReady = False
		' 100ms yield ticks for the cooperative scheduler
		Delay(100) 
        
		TimeoutCounter = TimeoutCounter + 1
		' 50 ticks * 100ms = 5000ms (5 Seconds Timeout)
		If TimeoutCounter >= 50 Then 
			ServerBootFailed = True
			' Break out of the endless loop safely!
			Exit 
		End If
	Loop
    
	If ServerBootFailed Then
		Log("[InitOPCUAServer][E] OPC UA Server initialization failed (TIMEOUT)")
		' Optional: Run local emergency fallback routine or let local sensors run offline
	Else
		Log("[InitOPCUAServer] Registering nodes...")

		' Register nodes
		
		' State of the gate open (1) or closed (0)
		OPCUAServer.AddIntNode(NODEID_STATE, "Gate State", STATE_GATE_OPEN)
		
		' Add trigger received from the client and call event OnDataWrite
		' The clients sends the commands to set the state of the gate to open or closed.
		OPCUAServer.AddStringNode(NODEID_TRIGGER, "Remote Action Trigger", "gateopen")
		
		' Register the native executable method node!
		'OpcServer.AddMethodNode("ExecuteJob", "Trigger Production Job Routine", "OnMethodCall")
		Log("[InitOPCUAServer] Nodes registered")
	End If
	Return Not(ServerBootFailed)
End Sub

' OnDataWrite
' Runs when client triggers the method over the network using namespace 1 and string identifier Trigger or trigger.
' Example B4J where the client sends value string gateopen: 
' OPCUAClient.Write("ns=1;s=trigger", "gateopen")
Private Sub OnDataWrite(buffer() As Byte)
	Dim cmd As String = ByteConv.StringFromBytes(buffer)
	Log("[OnDataWrite] Received from client method `trigger` with cmd=", cmd)

	Select cmd
		Case CMD_GATE_OPEN
			SetServoOpen
		Case CMD_GATE_CLOSE
			SetServoClosed
		' add more
	End Select
End Sub
#End Region

#Region Servo
Private Sub SetServoOpen
	LedRedState = False
	LedRedPin.DigitalWrite(LedRedState)
	LedGreenState = True
	LedGreenPin.DigitalWrite(LedGreenState)
	OPCUAServer.WriteNumeric(NAMESPACEINDEX, NODEID_STATE_STRING, STATE_GATE_OPEN)
	' OPCUAServer.WriteByteString(NAMESPACEINDEX, NODEID_STATE_STRING, Array As Byte(0x19, 0x01, 0x58))
	'
	SetServo(Servo, SERVO_PIN_NR, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE, SERVO_MIN_ANGLE)
End Sub

Private Sub SetServoClosed
	LedRedState = True
	LedRedPin.DigitalWrite(LedRedState)
	LedGreenState = False
	LedGreenPin.DigitalWrite(LedGreenState)
	OPCUAServer.WriteNumeric(NAMESPACEINDEX, NODEID_STATE_STRING, STATE_GATE_CLOSED)
	' OPCUAServer.WriteByteString(NAMESPACEINDEX, NODEID_STATE_STRING, Array As Byte(0x19, 0x00, 0x58))
	'
	SetServo(Servo, SERVO_PIN_NR, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE, SERVO_MAX_ANGLE)
End Sub

' Move servo to min and max positions only
Private Sub SetServo(srv As ESP32Servo, pinNumber As Byte, minAngle As Int, maxAngle As Int, posAngle As UInt)
	srv.Attach(pinNumber)
	Delay(20)
	If posAngle < minAngle Then posAngle = minAngle
	If posAngle > maxAngle Then posAngle = maxAngle
	srv.Write(posAngle)
	Delay(20)
	Log("[SetServo] Angle set to ", Servo.Read)
	Delay(20)
	srv.Detach
End Sub
#End Region

#Region Button
'Handle button state changed. 
'This is a pushbutton, means when pressing the button the LED will be turned on, when releasing again the LED is turned OFF.
Sub Button_StateChanged (State As Boolean)
	' Disable firsttime else led is turned on 
	If FirstTime Then
		FirstTime = Not(FirstTime)
		Return
	End If
	Log("[Button_StateChanged] Button state: ", State)
	
	'The state will be false when the button is clicked because of the PULLUP mode.
	If Not(State) Then
		If State Then
			SetServoOpen
		Else
			SetServoClosed
		End If
	End If
End Sub
#End Region

#if C
#include "esp_wifi.h"

void DisableWiFiSleep(B4R::Object* o) {
    // Force Espressif lwIP stack to set Power Save to NONE
    esp_wifi_set_ps(WIFI_PS_NONE);
    ::Serial.println("[Hardware Engine] Wi-Fi Modem-Sleep forcefully disabled! Radio set to high-performance mode.");
}
#End If
