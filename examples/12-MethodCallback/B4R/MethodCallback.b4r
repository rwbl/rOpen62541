'					// Clear any default payload string To prevent conflicts
'					msg.payload = ""; 
'					// Explicitly populate the target metadata fields that Node-RED looks For
'					msg.objectId = "ns=1;s=Factory_Floor";
'					msg.methodId = "ns=1;s=ExecuteJob";
'					// Supply the single required input argument parameters Array block
'					msg.inputArguments = [
'					    {
'					        dataType: "ByteString",
'					        value: "START_BATCH"
'					    }
'					];
'					Return msg;
'				Invoking results in NR response:
'					{
'						"objectId":"ns=1;s=Factory_Floor",
'						"methodId":"ns=1;s=ExecuteJob",
'						"inputArguments": [{"dataType":15,"value":[83,84,65,82,84,95,66,65,84,67,72],"arrayType":0}],
'						"outputArguments":[],
'						"result":{
'							"statusCode":{"value":0},
'							"outputArguments":[
'								{"dataType":"Int32","arrayType":"Scalar","value":100}]
'						},
'						"output":[
'							{"dataType":"Int32","arrayType":"Scalar","value":100}
						'],
'						"payload":0,"_msgid":"a85f46c06a93c646"
'					}
' B4R Log:			Receiving the message with argument START_BATCH.
'					[AppStart] rOpen62541 MethodCallback v20260913
'					[AppStart] WiFi connected > local IP=192.168.1.175
'					[AppStart] Init opc server
'					[InitOpcServer] Initializing...
