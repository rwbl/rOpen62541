#Region Project Header
'==============================================
' Project:		rOpen6241
' Brief:		Example method callback function.
' Date:			2026-09-12
' Author: 		Robert W.B. Linn
' License:		MIT — see LICENSE file.
' Description:	Node-Red to trigger the Method Call function using this script in the NR function node:
'				// Clear any default payload string To prevent conflicts
'				msg.payload = ""; 
'				// Explicitly populate the target metadata fields that Node-RED looks For
'				msg.objectId = "ns=1;s=Factory_Floor";
'				msg.methodId = "ns=1;s=ExecuteJob";
'				// Supply the single required input argument parameters Array block
'				msg.inputArguments = [
'				    {
'				        dataType: "ByteString",
'				        value: "START_BATCH"
'				    }
'				];
'				Return msg;
'				Invoking results in NR response:
'				{
'				"objectId":"ns=1;s=Factory_Floor",
'				"methodId":"ns=1;s=ExecuteJob",
'				"inputArguments":
'				[{"dataType":15,"value":[83,84,65,82,84,95,66,65,84,67,72],"arrayType":0}],
'				"outputArguments":[],
'				"result":{"statusCode":{"value":0},
'				"outputArguments":[{"dataType":"Int32","arrayType":"Scalar","value":100}]},"output":[{"dataType":"Int32","arrayType":"Scalar","value":100}],"payload":100,"_msgid":"a85f46c06a93c646"}
'				See below the B4R log handling the event with parameter START_BATCH.
' Hardware:		ESP32-S3-N16R8
'				Board settings:
'				Unleash the 8MB Octal PSRAM footprint
'				Partitionscheme: HUge App
'				PSRAM: OPI PSRAM
' Software:		B4R 4.00 (64 bit), IDE ESP32 Dev Module
'				Arduino Board Manager ESP32 3.3.11.
' Wiring:		N/A
' Log:
'[AppStart] rOpen62541 MethodCallback v20260913
'[AppStart] WiFi connected > local IP=192.168.1.175
'[AppStart] Init opc server
'[InitOpcServer] Initializing...
'[InitOpcServer] Awaiting background core network initialization...
'[opcuaServerTask] OPC UA Security: Anonymous Access Mode Active!
'[opcuaServerTask] OPC UA Server successfully running on Core 0!
'[InitOpcServer] Core 0 online! Spawning dynamic address space nodes...
'[AppStart] Opc server started
'[OpcMethodCallCallback] Client invoked the method node with argument: hex=START_BATCH string=53544152545F4241544348
'[OpcMethodCallCallback] Command accepted. Running production batch code...
'==============================================
#End Region

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 600
#End Region
'Ctrl+Click to open the C code folder: ide://run?File=%WINDIR%\System32\explorer.exe&Args=%PROJECT%\Objects\Src

Sub Process_Globals
	Private VERSION 			As String = "rOpen62541 MethodCallback v20260913"

	' Communication
	Public Serial1 				As Serial
	Private WiFi 				As ESP8266WiFi						' Lib rESP8266WiFi
	Private SSID				As String = "***"
	Private PW 					As String = "***"
	
	' Open62541
	Private OpcServer			As Open62541						' Lib rOpen62541
	Private PORT 				As Int = 4840
	
	'Helper
	Private bc As ByteConverter	'ignore
End Sub

Sub AppStart
	Serial1.Initialize(115200)
	Log(CRLF, "[AppStart] ", VERSION)
	
	' Connect to the network first
	If WiFi.Connect2(SSID, PW) Then
		Log("[AppStart] WiFi connected > local ip=", WiFi.LocalIP)
		' [AppStart] WiFi connected. IP=192.168.1.68

		' CRITICAL HARDWARE FIX: DISABLE WI-FI SLEEP LAYERS
		' Forces the ESP32-S3 Wi-Fi radio to stay 100% active, dropping latency
		' from ~100ms+ down to an immediate 2ms, completely wiping out Bad_Timeout.
		RunNative("DisableWiFiSleep", Null)
			       
		Log("[AppStart] Init opc server")
		If InitOpcServer Then
			Log("[AppStart] Opc server started")
		End If
	Else
		Log("[AppStart][E] WiFi Connection Failed")
	End If
End Sub

' InitOpcServer
' Steps:
' Init the server with ip, port and client callback
' Wait till the opc server has been started successfully
' Add various nodes
Private Sub InitOpcServer As Boolean
	Dim TimeoutCounter As Int = 0
	Dim ServerBootFailed As Boolean = False

	Log("[InitOpcServer] Initializing...")
	' Spin up the Core 0 open62541 network engine with callback
	OpcServer.Initialize(WiFi.LocalIp, PORT, "", "", "OpcCallback")
	
	' Wait for the background thread layout initialization to complete!
	Log("[InitOpcServer] Awaiting background core network initialization...")
	Do While OpcServer.IsReady = False
		' 100ms yield ticks for the cooperative scheduler
		Delay(100) 
        
		TimeoutCounter = TimeoutCounter + 1
		' 50 ticks * 100ms = 5000ms (5 Seconds Timeout)
		If TimeoutCounter >= 50 Then 
			ServerBootFailed = True
			' Break out of the endless loop safely!
			Exit 
		End If
	Loop
    
	If ServerBootFailed Then
		Log("[InitOpcServer][E] OPC UA Server initialization TIMEOUT! Core 0 failed.")
		' Optional: Run local emergency fallback routine or let local sensors run offline
	Else
		Log("[InitOpcServer] Core 0 online! Spawning dynamic address space nodes...")

		' Register the native executable method node!
		OpcServer.AddMethodNode("ExecuteJob", "Trigger Production Job Routine", "OpcMethodCallCallback")
		' Node-RED Example:
		' objectId = "ns=1;s=Factory_Floor"; methodId = "ns=1;s=ExecuteJob"; msg.inputArguments = [{dataType: "ByteString",value: "START_BATCH"}];
	End If
	Return Not(ServerBootFailed)
End Sub

' Fired automatically when a client invokes OpcServer.CallMethod()
' Bound directly to MethodCallSub execution loop
Private Sub OpcMethodCallCallback(InputParams() As Byte)
	Dim ParamText As String = bc.StringFromBytes(InputParams)
	Log("[OpcMethodCallCallback] Client invoked the method node with argument:", _
		" hex=", bc.StringFromBytes(InputParams), _
		" string=", bc.HexFromBytes(InputParams))
    
	' Evaluate your local logic parameters safely
	If ParamText = "START_BATCH" Then
		Log("[OpcMethodCallCallback] Command accepted. Running production batch code...")
        
		' Invoke via your active OpcServer instance prefix!
		OpcServer.SetMethodReturnCode(100) ' Sends "Success" back to SCADA
	Else
		Log("[OpcMethodCallCallback] Command rejected. Invalid parameter format.")
        
		' Invoke via your active OpcServer instance prefix!
		OpcServer.SetMethodReturnCode(400) ' Sends "Fault/Error" back to SCADA
	End If
End Sub

' OpcCallback
' Runs when client triggers the method over the network using namespace 1 and string identifier Trigger
' Example B4J where the client sends value 68: OpcClient.Write("ns=1;s=Trigger", 68)
Private Sub OpcCallback(buffer() As Byte)
	Log("[OpcCallback] SCADA/B4J Client clicked the trigger method. command=", bc.StringFromBytes(buffer))
	'[OpcCallback] SCADA/B4J Client clicked the trigger method. command=STOP
	'[OpcCallback] SCADA/B4J Client clicked the trigger method. command=68
End Sub

#if C
#include "esp_wifi.h"

void DisableWiFiSleep(B4R::Object* o) {
    // Force Espressif lwIP stack to set Power Save to NONE
    esp_wifi_set_ps(WIFI_PS_NONE);
    ::Serial.println("[Hardware Engine] Wi-Fi Modem-Sleep forcefully disabled! Radio set to high-performance mode.");
}
#End If
