@EndOfDesignText@
#Region Project Header
'==============================================
' Project:		rOpen62541
' Brief:		Example trigger and method callbacks.
' Date:			2026-10-09
' Author: 		Robert W.B. Linn (c) 2026 - MIT — see LICENSE file.
' Description:	Listen to commands received from the connected OPC UA client.
'				There are two events:
'				OnTriggerCall = received if the client writes to node ns=1;s=Trigger
'				OnMethodCall = received when the client invoked the method call.
' Hardware:		ESP32-S3-N16R8
'				Board settings:
'				Unleash the 8MB Octal PSRAM footprint
'				Partitionscheme: Huge App
'				PSRAM: OPI PSRAM
' Software:		B4R 4.00 (64 bit), B4R IDE Board selected ESP32S3 Dev Module COM15
'				Arduino Board Manager ESP32 3.3.11.
' Wiring:		N/A
'==============================================
#End Region

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 600
#End Region
'Ctrl+Click to open the C code folder: ide://run?File=%WINDIR%\System32\explorer.exe&Args=%PROJECT%\Objects\Src

Sub Process_Globals
	Private VERSION 				As String = "rOpen62541 Trigger&Method Callback v20261009"

	' Communication
	Public Serial1 					As Serial
	Private WiFi 					As ESP8266WiFi						' Lib rESP8266WiFi
	Private SSID					As String = "***"
	Private PW 						As String = "***"
	
	' Open62541
	Private OPCUAServer				As Open62541						' Lib rOpen62541
	Private PORT 					As Int = 4840
	Private NODEID_TRIGGER			As String = "ns=1;s=Trigger"		' Client sends string Trigger
	Private NODEID_TRIGGER_RESULT	As String = "ns=1;s=TriggerResult"	' Store the trigger result which the client can subscribe to
	Private NODEID_METHODCALL		As String = "ns=1;s=ExecuteJob"		' Client sends callmethod
	
	'Helper
	Private bc As ByteConverter	'ignore
End Sub

Sub AppStart
	Serial1.Initialize(115200)
	Log(CRLF, "[AppStart] ", VERSION)
	
	' Connect to the network first
	If WiFi.Connect2(SSID, PW) Then
		Log("[AppStart] WiFi connected > local ip=", WiFi.LocalIP)
		' [AppStart] WiFi connected. IP=192.168.1.68

		' DISABLE WI-FI SLEEP LAYERS
		' Forces the ESP32-S3 Wi-Fi radio to stay 100% active, dropping latency
		' from ~100ms+ down to an immediate 2ms, completely wiping out Bad_Timeout.
		RunNative("DisableWiFiSleep", Null)
			       
		Log("[AppStart] Init OPCUAServer server")
		If InitOPCUAServer Then
			Log("[AppStart] OPCUAServer server started")
		End If
	Else
		Log("[AppStart][E] WiFi Connection Failed")
	End If
End Sub

' InitOPCUAServer
' Steps:
' Init the server with ip, port and client callback
' Wait till the opc server has been started successfully
' Add various nodes
Private Sub InitOPCUAServer As Boolean
	Dim TimeoutCounter As Int = 0
	Dim ServerBootFailed As Boolean = False

	Log("[InitOPCUAServerServer] Initializing...")

	' Spin up the Core 0 open62541 network engine with callback
	OPCUAServer.Initialize(WiFi.LocalIp, PORT, "", "", "OnTriggerCall")
	
	' Wait for the background thread layout initialization to complete!
	Log("[InitOpcServer] Awaiting background core network initialization...")
	Do While OPCUAServer.IsReady = False
		' 100ms yield ticks for the cooperative scheduler
		Delay(100) 
        
		TimeoutCounter = TimeoutCounter + 1
		' 50 ticks * 100ms = 5000ms (5 Seconds Timeout)
		If TimeoutCounter >= 50 Then 
			ServerBootFailed = True
			' Break out of the endless loop safely!
			Exit 
		End If
	Loop
    
	If ServerBootFailed Then
		Log("[InitOPCUAServer][E] Initialization TIMEOUT! Core 0 failed.")
		' Optional: Run local emergency fallback routine or let local sensors run offline
	Else
		Log("[InitOPCUAServer] Core 0 online! Spawning dynamic address space nodes...")

		' Add trigger received from the client and call event OnMethodCall
		' The clients sends the commands to set the state of the gate to open or closed.
		OPCUAServer.AddTriggerNode(NODEID_TRIGGER, "Remote Trigger", "0")	
		' > Event OnTriggerCall
		' Node-RED example:
		' Send string START or buffer [1,2,3]

		OPCUAServer.AddIntNode(NODEID_TRIGGER_RESULT, "Remote Trigger Result", 0)

		' Register the native executable method node!
		OPCUAServer.AddMethodNode(NODEID_METHODCALL, "Remote Method Call", "OnMethodCall")	
		' > Event OnMethodCall
		' Node-RED Example:
		' objectId = "ns=1;s=Factory_Floor"; methodId = "ns=1;s=ExecuteJob"; msg.inputArguments = [{dataType: "ByteString",value: "START_BATCH"}];

	End If
	Return Not(ServerBootFailed)
End Sub

'==============================================
' EVENTS
'==============================================

' OnTriggerCall
' Runs when client triggers the method over the network using namespace 1 and string identifier Trigger
' In OPC UA, when a client changes a variable node, it is executing a Write service. This callback intercepts that write event.
Private Sub OnTriggerCall(buffer() As Byte)
	Log("[OnTriggerCall] OPC UA Client invoked trigger with argument=", bc.StringFromBytes(buffer), ", hex=", bc.HexFromBytes(buffer))
	' Received string:
	' [OnDataWrite] OPC UA Client invoked trigger with argument=START, hex=5354415254
	' Received byte array 0x01,0x02,0x03:
	' [OnDataWrite] OPC UA Client invoked trigger with argument=, hex=010203
	OPCUAServer.WriteNumeric(NODEID_TRIGGER_RESULT, Rnd(0, 11))
	'OPCUAServer.WriteNumeric(NODEID_TRIGGER_RESULT, OPCUAServer.STATUS_GOOD)
End Sub

' OnMethodCall
' Fired automatically when a client invokes OpcServer.CallMethod()
' In OPC UA, executing a method node uses the standard Call service. This callback handles that explicit method call request.
' Bound directly to MethodCallSub execution loop.
Private Sub OnMethodCall(InputParams() As Byte)
	Dim ParamText As String = bc.StringFromBytes(InputParams)
	Log("[OnMethodCall] OPC UA Client invoked method with argument=", bc.StringFromBytes(InputParams), ", hex=", bc.HexFromBytes(InputParams))
	' [OnMethodCall] OPC UA Client invoked method with argument=START_BATCH
	
	' Example evaluate action
	If ParamText = "START_BATCH" Then
		Log("[OnMethodCall] Command accepted. Running production batch code...")
        
		' Sends "Success" back to OPC UA client
		OPCUAServer.SetMethodReturnCode(OPCUAServer.STATUS_GOOD)
	Else
		Log("[OnMethodCall] Command rejected. Invalid parameter format.")
        
		' Sends "Fault/Error" back to OPC UA client
		OPCUAServer.SetMethodReturnCode(OPCUAServer.STATUS_FAILURE)
	End If
End Sub

'==============================================
' HELPER
'==============================================

#if C
#include "esp_wifi.h"

void DisableWiFiSleep(B4R::Object* o) {
    // Force Espressif lwIP stack to set Power Save to NONE
    esp_wifi_set_ps(WIFI_PS_NONE);
    ::Serial.println("[Hardware Engine] Wi-Fi Modem-Sleep forcefully disabled! Radio set to high-performance mode.");
}
#End If
