    {
        "id": "45082dbfc48ca611",
        "type": "function",
        "z": "f1",
        "name": "Set MethodCall Message",
        "func": "// Clear any default payload string to prevent conflicts\nmsg.payload = \"\"; \n\n// Explicitly populate the target metadata fields that Node-RED looks for\nmsg.objectId = \"ns=1;s=Factory_Floor\";\nmsg.methodId = \"ns=1;s=ExecuteJob\";\n\n// Supply the single required input argument parameters array block\nmsg.inputArguments = [\n    {\n        dataType: \"ByteString\",\n        value: \"START_BATCH\"\n    }\n];\n\nreturn msg;\n\n/*\n{\n\"objectId\":\"ns=1;s=Factory_Floor\",\n\"methodId\":\"ns=1;s=ExecuteJob\",\n\"inputArguments\":\n[{\"dataType\":15,\"value\":[83,84,65,82,84,95,66,65,84,67,72],\"arrayType\":0}],\n\"outputArguments\":[],\n\"result\":{\"statusCode\":{\"value\":0},\n\"outputArguments\":[{\"dataType\":\"Int32\",\"arrayType\":\"Scalar\",\"value\":100}]},\"output\":[{\"dataType\":\"Int32\",\"arrayType\":\"Scalar\",\"value\":100}],\"payload\":100,\"_msgid\":\"a85f46c06a93c646\"}\n*/",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 600,
        "wires": [
            [
                "c70d4fefcc1f2a06"
            ]
        ]
    },
    {
        "id": "7a9371fe34a4af8c",
        "type": "switch",
        "z": "f1",
