        "label": "OPC UA Test",
        "disabled": false,
        "info": "",
        "env": []
    },
    {
        "id": "6104392eae7aec40",
        "type": "comment",
        "z": "29c14dcdb14a6011",
        "name": "",
        "info": "import asyncio\nfrom bleak import BleakClient, BleakScanner\n\nCONTROL_UUID_1 = \"000092d1-0000-1000-8000-00805f9b34fb\"\nCONTROL_UUID_2 = \"00060001-f8ce-11e4-abf4-0002a5d5c51b\"\n\n\nasync def main():\n    # Scan up to 3 times\n    buwizz = None\n    for attempt in range(3):\n        print(f\"🔎 Scan attempt {attempt+1} (10s)…\")\n        devices = await BleakScanner.discover(timeout=10)\n        print(devices)\n        for d in devices:\n            print(f\"  Found device: {d.name} [{d.address}]\")\n        buwizz = next((d for d in devices if d.name and \"BuWizz\" in d.name), None)\n        if buwizz:\n            print(f\"\\n✅ BuWizz found: {buwizz.name} [{buwizz.address}]\\n\")\n            break\n        else:\n            print(\"⚠️  BuWizz not found, retrying…\\n\")\n            await asyncio.sleep(2)\n    else:\n        print(\"❌ Failed to find BuWizz after 3 attempts.\")\n        return\n\n    print(\"🔗 Connecting…\")\n    async with BleakClient(buwizz.address) as client:\n        print(\"✅ Connected to BuWizz.\\n\")\n\n        # List all services & characteristics\n        print(\"📋 Services & Characteristics:\")\n        for service in client.services:\n            print(f\"Service: {service.uuid}\")\n            for char in service.characteristics:\n                props = ','.join(char.properties)\n                print(f\"  └─ Characteristic: {char.uuid} | props: [{props}]\")\n\n        # Test both writable characteristics\n        print(\"\\n⚙️  Attempting to control motor…\")\n\n        for i, char_uuid in enumerate([CONTROL_UUID_1, CONTROL_UUID_2], start=1):\n            print(f\"➡️  Trying characteristic {i}: {char_uuid}\")\n            try:\n                print(\"   🔄 Sending motor ON (speed 50)…\")\n                await client.write_gatt_char(char_uuid, bytearray([0x01, 50]))\n                await asyncio.sleep(2)\n\n                print(\"   🔄 Sending motor OFF (speed 0)…\")\n                await client.write_gatt_char(char_uuid, bytearray([0x01, 0]))\n                print(f\"✅ Wrote to characteristic {i} successfully.\\n\")\n\n            except Exception as e:\n                print(f\"❌ Failed writing to characteristic {i}: {e}\\n\")\n\n        print(\"🏁 Done. Disconnecting…\")\n\n    print(\"🚪 Disconnected. Bye 👋\")\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n\n",
        "x": 120,
        "y": 40,
        "wires": []
    },
