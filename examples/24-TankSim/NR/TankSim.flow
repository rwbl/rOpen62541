    {
        "id": "4cbacf57cde34e03",
        "type": "function",
        "z": "35fcce6ae05860ab",
        "name": "Convert Result",
        "func": "/*\nB4R sends like:\nOpcServer.SetMethodReturnCode(OpcServer.STATUS_GOOD) [0x00000000]\nOpcServer.SetMethodReturnCode(OpcServer.STATUS_FAILURE) [0x80000000]\n\nwhich values are then converted from usigned to signed using bit shiftig >>>.\n*/\n\n// Converts -2147483648 into 2147483648 (0x80000000) instantly\nmsg.payload = msg.payload >>> 0;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 620,
        "wires": [
            [
                "5ff5297c32c1241c"
            ]
        ]
    },
