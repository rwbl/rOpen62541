    {
        "id": "92180df80d14a10c",
        "type": "function",
        "z": "35fcce6ae05860ab",
        "name": "Set Tank1Setpoint",
        "func": "// 1. Extract the number from your input (e.g., from a dashboard slider or input)\nlet sp = parseFloat(msg.payload); \n\n// 2. Set the target OPC UA Node ID string\nmsg.topic = \"ns=1;s=Tank1.Setpoint\";\n\n// 3. Assign the direct raw value to the payload\nmsg.payload = sp;\n\n// 4. CRITICAL: Force Node-RED to send it as a 32-bit Float, matching your B4R server\nmsg.datatype = \"Float\"; \n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
